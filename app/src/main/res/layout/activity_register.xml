<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc_casse"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MiniShopManager"
            android:textColor="@color/bordeaux"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer votre compte"
            android:textColor="@color/bordeaux"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rejoignez notre boutique !"
            android:textColor="@color/gris_texte"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nom complet"
            android:inputType="textPersonName"
            android:padding="15dp"
            android:backgroundTint="@color/rose_fonce"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Adresse e-mail"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/rose_fonce"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/rose_fonce"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirmer le mot de passe"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/rose_fonce"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CRÉER MON COMPTE"
            android:textColor="@color/white"
            android:backgroundTint="@color/bordeaux"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/tvBackLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Déjà un compte ? Se connecter"
            android:textColor="@color/bordeaux"
            android:textSize="14sp"
            android:padding="15dp"
            android:layout_marginTop="15dp"/>

    </LinearLayout>

</ScrollView>
