<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc_casse"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MiniShopManager"
            android:textColor="@color/bordeaux"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="55dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Votre boutique, votre style"
            android:textColor="@color/rose_fonce"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenue !"
            android:textColor="@color/bordeaux"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="55dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connectez-vous pour découvrir nos produits."
            android:textColor="@color/gris_texte"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp" />

        <EditText
            android:id="@+id/etStudentName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Adresse e-mail"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:backgroundTint="@color/rose_fonce"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/rose_fonce"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/cbRemember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Se souvenir de moi"
            android:textColor="@color/bordeaux"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SE CONNECTER"
            android:textColor="@color/white"
            android:backgroundTint="@color/bordeaux"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pas encore de compte ? Inscrivez-vous"
            android:textColor="@color/bordeaux"
            android:textSize="14sp"
            android:layout_marginTop="25dp"
            android:padding="10dp" />

    </LinearLayout>

</ScrollView>
