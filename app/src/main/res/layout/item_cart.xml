<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvCartProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nom du produit"
        android:textColor="@color/bordeaux"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDecrease"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="−"
            android:textSize="20sp"
            android:textColor="@color/bordeaux"
            android:backgroundTint="@color/rose_clair" />

        <TextView
            android:id="@+id/tvCartQuantity"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/bordeaux"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnIncrease"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="+"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/bordeaux" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Supprimer"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/rose_fonce"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>
