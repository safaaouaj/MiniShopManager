<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc_casse">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon profil"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/bordeaux"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenue dans votre espace personnel"
            android:textSize="15sp"
            android:textColor="@color/gris_texte"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom complet"
                android:textColor="@color/gris_texte"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom utilisateur"
                android:textColor="@color/bordeaux"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adresse e-mail"
                android:textColor="@color/gris_texte"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textColor="@color/bordeaux"
                android:textSize="16sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="DÉCONNEXION"
            android:textColor="@color/white"
            android:backgroundTint="@color/bordeaux"
            android:layout_marginTop="30dp" />

    </LinearLayout>
</ScrollView>