<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc_casse">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validation de commande"
            android:textColor="@color/bordeaux"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Récapitulatif de votre panier"
            android:textColor="@color/bordeaux"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCheckoutSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Votre panier"
            android:textColor="@color/gris_texte"
            android:textSize="15sp"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvCheckoutTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total : 0.00 DT"
            android:textColor="@color/bordeaux"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informations de livraison"
            android:textColor="@color/bordeaux"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etDeliveryName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nom complet"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:backgroundTint="@color/rose_fonce" />

        <EditText
            android:id="@+id/etDeliveryPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Téléphone de livraison (fictif pour le test)"
            android:inputType="phone"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rose_fonce" />

        <EditText
            android:id="@+id/etDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Adresse de livraison (fictive pour le test)"
            android:inputType="textPostalAddress|textMultiLine"
            android:gravity="top"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rose_fonce" />

        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CONFIRMER LA COMMANDE"
            android:textColor="@color/white"
            android:backgroundTint="@color/bordeaux"
            android:layout_marginTop="25dp" />

        <Button
            android:id="@+id/btnBackCart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="RETOURNER AU PANIER"
            android:textColor="@color/bordeaux"
            android:backgroundTint="@color/rose_clair"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
